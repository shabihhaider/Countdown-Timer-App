<div class="cdp"
     data-shop="{{ shop.permanent_domain }}"
     data-style="{{ block.settings.style }}"
     data-text-color="{{ block.settings.text_color }}"
     data-accent-color="{{ block.settings.accent_color }}"
     data-bg-color="{{ block.settings.bg_color }}"
     data-font-size="{{ block.settings.font_size }}"
     data-show-label="{{ block.settings.show_label }}"
     data-label-text="{{ block.settings.label_text }}"
     style="display: none;"
     role="timer"
     aria-label="Countdown timer">

  {% if block.settings.show_label %}
  <span class="cdp__label">{{ block.settings.label_text }}</span>
  {% endif %}

  <span class="cdp__digits">
    <span class="cdp__unit">
      <span class="cdp__value cdp__days">00</span>
      <span class="cdp__unit-label">d</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__hours">00</span>
      <span class="cdp__unit-label">h</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__mins">00</span>
      <span class="cdp__unit-label">m</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__secs">00</span>
      <span class="cdp__unit-label">s</span>
    </span>
  </span>

  <!-- Screen reader announcement -->
  <span class="cdp__sr" aria-live="polite" aria-atomic="true"></span>

  {% if block.settings.show_stock_alert %}
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign qty = current_variant.inventory_quantity %}
    {% assign threshold = block.settings.low_stock_threshold %}

    {% if current_variant.inventory_management == 'shopify'
       and current_variant.inventory_policy == 'deny'
       and qty > 0
       and qty <= threshold %}
      <div class="cdp__stock-alert" style="color: {{ block.settings.stock_alert_color }};">
        <span class="cdp__stock-icon" aria-hidden="true">⚠</span>
        <span class="cdp__stock-text">
          {{ block.settings.stock_message | replace: '{count}', qty }}
        </span>
        {% if block.settings.show_stock_bar %}
          <div class="cdp__stock-bar" role="progressbar"
               aria-valuenow="{{ qty }}" aria-valuemin="0"
               aria-valuemax="{{ threshold }}">
            <div class="cdp__stock-bar-fill"
                 style="width: {{ qty | times: 100 | divided_by: threshold | at_most: 100 }}%;
                        background-color: {{ block.settings.stock_alert_color }};">
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Countdown Timer",
  "target": "section",
  "stylesheet": "countdown-product.css",
  "javascript": "countdown-product.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Timer style",
      "options": [
        { "value": "minimal", "label": "Minimal (text only)" },
        { "value": "card", "label": "Card (bordered box)" },
        { "value": "badge", "label": "Badge (colored pill)" }
      ],
      "default": "minimal"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Digit color",
      "default": "#dc2626"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label text",
      "default": true
    },
    {
      "type": "text",
      "id": "label_text",
      "label": "Label text",
      "default": "Sale ends in"
    },
    {
      "type": "header",
      "content": "Low Stock Alert"
    },
    {
      "type": "checkbox",
      "id": "show_stock_alert",
      "label": "Show low stock alert",
      "default": false
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5,
      "info": "Show alert when inventory is at or below this number"
    },
    {
      "type": "text",
      "id": "stock_message",
      "label": "Stock message",
      "default": "Only {count} left in stock!",
      "info": "Use {count} for the inventory number"
    },
    {
      "type": "color",
      "id": "stock_alert_color",
      "label": "Alert text color",
      "default": "#dc2626"
    },
    {
      "type": "checkbox",
      "id": "show_stock_bar",
      "label": "Show stock level bar",
      "default": true,
      "info": "Visual bar showing remaining stock"
    }
  ]
}
{% endschema %}
