<div class="cdp"
     data-shop="{{ shop.permanent_domain }}"
     data-api-url="{{ shop.metafields.countdown_timer.api_url.value }}"
     data-font-size="{{ block.settings.font_size }}"
     data-border-radius="{{ block.settings.border_radius }}"
     data-padding="{{ block.settings.padding }}"
     data-alignment="{{ block.settings.alignment }}"
     data-show-label="{{ block.settings.show_label }}"
     data-show-icon="{{ block.settings.show_icon }}"
     data-product-handle="{{ product.handle }}"
     data-collection-handles="{{ product.collections | map: 'handle' | join: ',' }}"
     data-product-tags="{{ product.tags | join: ',' }}"
     style="display: none;"
     role="timer"
     aria-label="Countdown timer">

  {% if block.settings.show_icon %}
  <span class="cdp__icon" aria-hidden="true" style="display:none;"></span>
  {% endif %}

  {% if block.settings.show_label %}
  <span class="cdp__label"></span>
  {% endif %}

  <span class="cdp__digits">
    <span class="cdp__unit">
      <span class="cdp__value cdp__days">00</span>
      <span class="cdp__unit-label">d</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__hours">00</span>
      <span class="cdp__unit-label">h</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__mins">00</span>
      <span class="cdp__unit-label">m</span>
    </span>
    <span class="cdp__sep">:</span>
    <span class="cdp__unit">
      <span class="cdp__value cdp__secs">00</span>
      <span class="cdp__unit-label">s</span>
    </span>
  </span>

  <!-- Screen reader announcement -->
  <span class="cdp__sr" aria-live="polite" aria-atomic="true"></span>

  {% if block.settings.show_stock_alert %}
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign qty = current_variant.inventory_quantity %}
    {% assign threshold = block.settings.low_stock_threshold %}

    {% if current_variant.inventory_management == 'shopify'
       and current_variant.inventory_policy == 'deny'
       and qty > 0
       and qty <= threshold %}
      <div class="cdp__stock-alert" style="color: {{ block.settings.stock_alert_color }};">
        <span class="cdp__stock-icon" aria-hidden="true">⚠</span>
        <span class="cdp__stock-text">
          {%- assign count_placeholder = '{count}' -%}
          {{ block.settings.stock_message | replace: count_placeholder, qty }}
        </span>
        {% if block.settings.show_stock_bar %}
          <div class="cdp__stock-bar" role="progressbar"
               aria-label="Stock level"
               aria-valuenow="{{ qty }}" aria-valuemin="0"
               aria-valuemax="{{ threshold }}">
            <div class="cdp__stock-bar-fill"
                 style="width: {{ qty | times: 100 | divided_by: threshold | at_most: 100 }}%;
                        background-color: {{ block.settings.stock_alert_color }};">
            </div>
          </div>
        {% endif %}
      </div>
    {% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Countdown Timer",
  "target": "section",
  "stylesheet": "countdown-product.css",
  "javascript": "countdown-product.js",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout & Display"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Inner padding",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_label",
      "label": "Show label text",
      "default": true,
      "info": "Label text, colors, and style are set in the app admin"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show timer icon",
      "default": true,
      "info": "Icon is set in the app admin campaign settings"
    },
    {
      "type": "header",
      "content": "Low Stock Alert"
    },
    {
      "type": "checkbox",
      "id": "show_stock_alert",
      "label": "Show low stock alert",
      "default": false
    },
    {
      "type": "range",
      "id": "low_stock_threshold",
      "label": "Low stock threshold",
      "min": 1,
      "max": 50,
      "step": 1,
      "default": 5,
      "info": "Show alert when inventory is at or below this number"
    },
    {
      "type": "text",
      "id": "stock_message",
      "label": "Stock message",
      "default": "Only {count} left in stock!",
      "info": "Use {count} for the inventory number"
    },
    {
      "type": "color",
      "id": "stock_alert_color",
      "label": "Alert text color",
      "default": "#dc2626"
    },
    {
      "type": "checkbox",
      "id": "show_stock_bar",
      "label": "Show stock level bar",
      "default": true,
      "info": "Visual bar showing remaining stock"
    }
  ]
}
{% endschema %}
