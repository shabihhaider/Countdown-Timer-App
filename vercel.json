{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm ci",
  "framework": "remix",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/apps/countdown/settings",
      "dest": "/apps/countdown/settings"
    },
    {
      "src": "/apps/countdown/track",
      "dest": "/apps/countdown/track"
    }
  ]
}
