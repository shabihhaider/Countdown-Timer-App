# ==============================================================================
# WARNING: Never commit real secrets to version control.
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be pushed.
# ==============================================================================
#
# RECOMMENDED WORKFLOW:
#   1. make services        → starts DB + Redis via Docker
#   2. npm run dev          → runs shopify app dev (tunnel + HMR + OAuth)
#   3. Code + test in Shopify admin
#   4. git checkout -b feat/xyz → git push → create PR → Vercel preview
#   5. Merge PR → auto-deploy to production
#
# ==============================================================================

# ─── Shopify App ─────────────────────────────────────────────────────────────
# From https://partners.shopify.com → Apps → Your App → API credentials
SHOPIFY_API_KEY=your_shopify_api_key_here              # [SECRET] App client ID
SHOPIFY_API_SECRET=your_shopify_api_secret_here        # [SECRET] App client secret

# Leave as localhost — shopify app dev auto-creates a tunnel and overrides this.
# You do NOT need to set this manually.
SHOPIFY_APP_URL=http://localhost:3000                   # [CONFIG] Auto-overridden by Shopify CLI

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These configure the Docker PostgreSQL container:
POSTGRES_DB=countdown_timer                            # [CONFIG] Database name
POSTGRES_USER=postgres                                 # [CONFIG] Database user
POSTGRES_PASSWORD=dev_password_change_in_prod          # [SECRET] Change in production!
POSTGRES_PORT=5432                                     # [CONFIG] Host port for PostgreSQL

# Connection strings — used by Prisma when running natively (shopify app dev).
# Docker Compose overrides these internally to point at the db service.
DATABASE_URL=postgresql://postgres:dev_password_change_in_prod@localhost:5432/countdown_timer
DIRECT_URL=postgresql://postgres:dev_password_change_in_prod@localhost:5432/countdown_timer

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379                       # [CONFIG] Redis connection
REDIS_PASSWORD=                                        # [SECRET] Leave empty for local dev

# ─── App Server ──────────────────────────────────────────────────────────────
PORT=3000                                              # [CONFIG] App server port
HMR_SERVER_PORT=8002                                   # [CONFIG] HMR WebSocket port (tunnel mode)

# ─── Tooling ─────────────────────────────────────────────────────────────────
ADMINER_PORT=8888                                      # [CONFIG] Adminer UI port

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development                                   # [CONFIG] development | production | test
