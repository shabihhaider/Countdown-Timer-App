# ==============================================================================
# WARNING: Never commit real secrets to version control.
# Copy this file to .env and fill in your values.
# The .env file is gitignored and must never be pushed.
# ==============================================================================

# ─── Shopify App ─────────────────────────────────────────────────────────────
# From https://partners.shopify.com → Apps → Your App → API credentials
SHOPIFY_API_KEY=your_shopify_api_key_here              # [SECRET] App client ID
SHOPIFY_API_SECRET=your_shopify_api_secret_here        # [SECRET] App client secret

# Public HTTPS URL where Shopify can reach your app.
#
# Localhost mode (default — no tunnel, HMR on port 64999):
#   SHOPIFY_APP_URL=http://localhost:3000
#
# Tunnel mode — run `make dev-tunnel`, then paste the URL shown in logs:
#   SHOPIFY_APP_URL=https://xxxx.trycloudflare.com
#
# Ngrok:
#   SHOPIFY_APP_URL=https://xxxx.ngrok.io
SHOPIFY_APP_URL=http://localhost:3000                  # [CONFIG] App URL

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_DB=countdown_timer                            # [CONFIG] Database name
POSTGRES_USER=postgres                                 # [CONFIG] Database user
POSTGRES_PASSWORD=dev_password_change_in_prod          # [SECRET] Database password — change in production!
POSTGRES_PORT=5432                                     # [CONFIG] Host port for PostgreSQL

# DATABASE_URL and DIRECT_URL are auto-constructed by docker-compose.yml using
# the POSTGRES_* variables above and pointing at the db service.
# Uncomment ONLY when connecting to an external database (e.g. Neon).
#DATABASE_URL=postgresql://user:pass@host/dbname       # [SECRET] Full connection string
#DIRECT_URL=postgresql://user:pass@host/dbname         # [SECRET] Direct (non-pooled) connection

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                                        # [SECRET] Leave empty for local dev (no auth)
REDIS_PORT=6379                                        # [CONFIG] Host port for Redis

# ─── App Server ──────────────────────────────────────────────────────────────
PORT=3000                                              # [CONFIG] App server port
HMR_SERVER_PORT=8002                                   # [CONFIG] HMR WebSocket port (tunnel mode)

# ─── Tooling ─────────────────────────────────────────────────────────────────
# Adminer DB admin UI — http://localhost:ADMINER_PORT
# Only starts with: docker compose --profile tools up
ADMINER_PORT=8888                                      # [CONFIG] Adminer UI port

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development                                   # [CONFIG] development | production | test
