generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  // Added by @shopify/shopify-app-session-storage-prisma v10 (SDK v5)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// Legacy table — kept for backwards compatibility during migration.
// New installs use Campaign model. Remove after full data migration.
model Setting {
  id        Int      @id @default(autoincrement())
  shop      String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A countdown campaign configured by a merchant.
model Campaign {
  id               Int                @id @default(autoincrement())
  shop             String
  name             String             @default("My Sale")
  type             String             @default("bar") // "bar" | "product_timer"
  isActive         Boolean            @default(true)

  // Display content
  barMessage       String             @default("Flash Sale Ends In...")
  buttonText       String             @default("Shop Now")
  buttonUrl        String             @default("/collections/all")
  discountCode     String             @default("")               // optional promo code to display

  // Timer type and scheduling
  timerType        String             @default("one_time")  // "one_time" | "daily" | "evergreen"
  startDate        DateTime?
  endDate          DateTime?
  timezone         String             @default("UTC")
  dailyResetTime   String             @default("00:00")     // HH:MM for daily timers
  evergreenMinutes Int                @default(30)           // duration for evergreen timers

  // Design
  barIcon               String        @default("")       // emoji icon shown before bar message
  backgroundColor       String        @default("#288d40")
  textColor             String        @default("#ffffff")
  buttonTextColor       String        @default("#111111")
  buttonBackgroundColor String        @default("#ffffff")
  fontFamily            String        @default("system") // font family identifier
  animationStyle        String        @default("none")   // "none" | "fade" | "slide"
  backgroundStyle       String        @default("")       // JSON: gradient config (empty = solid backgroundColor)
  position              String        @default("top")   // "top" | "bottom"

  // Product timer design
  productStyle          String        @default("minimal") // "minimal" | "card" | "badge" | "banner" | "floating"
  accentColor           String        @default("#dc2626")
  labelText             String        @default("Sale ends in")

  // Behaviour after expiry
  endAction        String             @default("hide")  // "hide" | "show_ended" | "show_custom"
  customEndMessage String             @default("")

  // Optional page-level targeting (JSON array of URL patterns)
  pageTargeting    String             @default("[]")

  // Product/collection targeting
  targetType          String          @default("all")   // "all" | "specific_products" | "specific_collections" | "tagged_products"
  targetProductIds    String          @default("[]")     // JSON array of Shopify product GIDs
  targetCollectionIds String          @default("[]")     // JSON array of Shopify collection GIDs
  targetTags          String          @default("[]")     // JSON array of product tag strings

  // Priority for multi-campaign resolution (higher = takes precedence)
  priority            Int             @default(0)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  analytics        CampaignAnalytics[]

  @@index([shop])
  @@index([shop, isActive])
  @@index([shop, type, isActive])
}

// Daily aggregated analytics per campaign.
model CampaignAnalytics {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  date        DateTime @db.Date   // day bucket (UTC date only)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  closes      Int      @default(0)

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([campaignId, date])
  @@index([campaignId])
}

// Persistent shop lifecycle record. Survives uninstall (soft-close);
// anonymized — never deleted — on GDPR shop/redact so aggregate history stays intact.
model Shop {
  id               Int       @id @default(autoincrement())
  domain           String    @unique // "*.myshopify.com"; replaced with "redacted-<token>" on shop/redact
  name             String?
  email            String? // PII — scrubbed on redact
  status           String    @default("active") // "active" | "uninstalled" | "redacted"
  plan             String    @default("Free") // cached; source of truth = Subscription rows + webhook
  planSource       String? // "webhook" | "billing_check" | "backfill"
  planUpdatedAt    DateTime?
  installedAt      DateTime  @default(now()) // most recent install
  firstInstalledAt DateTime  @default(now()) // never overwritten on reinstall
  uninstalledAt    DateTime?
  redactedAt       DateTime?
  installCount     Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions Subscription[]
  events        AppEvent[]

  @@index([status])
  @@index([plan, status])
  @@index([installedAt])
  @@index([uninstalledAt])
}

// One row per Shopify AppSubscription gid. Upserted by the app_subscriptions/update webhook.
model Subscription {
  id                    Int       @id @default(autoincrement())
  shopId                Int
  shopifySubscriptionId String    @unique // "gid://shopify/AppSubscription/..."
  planName              String
  status                String // "ACTIVE" | "CANCELLED" | "EXPIRED" | "FROZEN" | "DECLINED" | "PENDING"
  price                 Decimal   @db.Decimal(10, 2)
  currencyCode          String    @default("USD")
  interval              String    @default("EVERY_30_DAYS")
  trialDays             Int       @default(0)
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  isTest                Boolean   @default(false)
  activatedAt           DateTime?
  cancelledAt           DateTime?
  shopifyUpdatedAt      DateTime? // updated_at from the webhook payload — guards out-of-order delivery
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([status])
  @@index([trialEndsAt])
}

// Append-only lifecycle timeline (installs, uninstalls, plan changes) read by internal tooling.
model AppEvent {
  id         Int      @id @default(autoincrement())
  shopId     Int?
  shopDomain String // denormalized; scrubbed to the redacted token on shop/redact
  type       String // "app_installed" | "app_reinstalled" | "app_uninstalled" |
  // "subscription_updated" | "plan_changed" | "shop_redacted"
  payload    Json?
  webhookId  String?  @unique // X-Shopify-Webhook-Id — makes webhook retries idempotent
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, occurredAt])
  @@index([type, occurredAt])
  @@index([occurredAt])
}

// Tracks onboarding wizard progress per shop.
model OnboardingState {
  id              Int      @id @default(autoincrement())
  shop            String   @unique
  step1Complete   Boolean  @default(false)   // Campaign configured
  step2Complete   Boolean  @default(false)   // Design chosen
  step3Complete   Boolean  @default(false)   // Extension installed in theme
  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
